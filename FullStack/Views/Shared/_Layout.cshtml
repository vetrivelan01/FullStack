<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Citizen Record System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-person-badge-fill me-2 fs-3 text-gradient"></i>
                    <span>Citizen Record System</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <i class="bi bi-list fs-1"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Citizen" asp-action="Index">Citizens</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Document" asp-action="Index">Documents</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Record" asp-action="Index">Records</a>
                            </li>
                            <li class="nav-item ms-lg-3">
                                <div class="dropdown">
                                    <button class="btn btn-primary d-flex align-items-center dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end glass-card border-0 shadow-lg mt-2">
                                        <li><a class="dropdown-item py-2" asp-controller="Address" asp-action="Index"><i
                                                    class="bi bi-geo-alt me-2"></i> Addresses</a></li>
                                        <li>
                                            <hr class="dropdown-divider opacity-10">
                                        </li>
                                        <li><a class="dropdown-item py-2 text-danger" asp-controller="Login"
                                                asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-primary px-4" asp-controller="Login" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-top: 100px;">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3">Citizen Record System</h5>
                    <p class="small">The secure digital gateway for citizen identification and official record
                        management. Built for efficiency and compliance.</p>
                </div>
                <div class="col-lg-2 ms-auto">
                    <h6 class="text-white fw-bold mb-3">System</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#">Status</a></li>
                        <li class="mb-2"><a href="#">About</a></li>
                        <li class="mb-2"><a href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h6 class="text-white fw-bold mb-3">Legal</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        </li>
                        <li class="mb-2"><a href="#">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 opacity-10">
            <div class="d-flex justify-content-between align-items-center">
                <p class="mb-0 small">&copy; 2026 Citizen Record Digital Governance. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-github"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
