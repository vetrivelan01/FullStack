@model FullStack.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="auth-glass">
                <div class="auth-header">
                    <i class="bi bi-person-plus-fill fs-2 d-block mb-2"></i>
                    <h4>Citizen Registration</h4>
                    <p class="mb-0 small opacity-75">Create your secure digital identity</p>
                </div>
                <div class="p-4 p-md-5">
                    <form asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <h6 class="fw-700 text-uppercase smaller ls-1 mb-3 d-flex align-items-center">
                            <i class="bi bi-key me-2 text-primary"></i> Account Credentials
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="LoginID" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="LoginID" class="form-control shadow-none" required
                                    placeholder="Choose a unique Login ID" />
                                <span asp-validation-for="LoginID" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="Password" class="form-control shadow-none" type="password" required
                                    placeholder="Create password" />
                                <span asp-validation-for="Password" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword"
                                    class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="ConfirmPassword" class="form-control shadow-none" type="password"
                                    required placeholder="Confirm password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger smaller"></span>
                            </div>
                        </div>

                        <hr style="border-color: rgba(255,255,255,0.06);">

                        <h6 class="fw-700 text-uppercase smaller ls-1 mb-3 mt-4 d-flex align-items-center">
                            <i class="bi bi-person-badge me-2 text-primary"></i> Personal Information
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="CitizenName" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="CitizenName" class="form-control shadow-none" required
                                    placeholder="Your full legal name" />
                                <span asp-validation-for="CitizenName" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="DateOfBirth" class="form-control shadow-none" type="date" required 
                                    max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-600 smaller text-uppercase"></label>
                                <select asp-for="Gender" class="form-select shadow-none" required>
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Nationality" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="Nationality" class="form-control shadow-none" required
                                    placeholder="e.g. US, UK, CA" />
                                <span asp-validation-for="Nationality" class="text-danger smaller"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-600 smaller text-uppercase"></label>
                                <input asp-for="PhoneNumber" class="form-control shadow-none" required
                                    placeholder="Phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger smaller"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fw-700 shadow-glow">
                                <i class="bi bi-shield-check me-2"></i>Complete Registration
                            </button>
                        </div>
                    </form>
                    <div class="text-center mt-4">
                        <a asp-action="Index" class="text-muted small">Already have an account? <span
                                class="text-primary fw-600">Sign in</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
