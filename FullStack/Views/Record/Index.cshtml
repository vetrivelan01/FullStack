@model IEnumerable<CitizenRecord>
@{
    ViewData["Title"] = "Official Records";
}

<div class="fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 fw-800 mb-1"><i class="bi bi-archive text-gradient me-2"></i> Audit <span
                    class="text-gradient">Records</span></h1>
            <p class="text-muted small mb-0">Track official audit logs and verification history across the identity
                network.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-plus"></i> <span>Submit New Record</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="glass-card mb-5">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-lg-9">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 ps-0"><i
                                class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                            class="form-control border-0 shadow-none bg-transparent"
                            placeholder="Filter by Citizen ID, verification status, or record ID..." />
                    </div>
                </div>
                <div class="col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 px-4">Search</button>
                    <a asp-action="Index" class="btn btn-light px-3" title="Reset Filters"><i
                            class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 glass-card animate-on-scroll">
            <i class="bi bi-clipboard-x display-4 text-muted opacity-25 mb-3"></i>
            <h5 class="text-muted">No audit records found</h5>
            <p class="small text-muted mb-0">Try broad search terms or clear existing filters.</p>
        </div>
    }
    else
    {
        <div class="row g-4 animate-on-scroll">
            @foreach (var item in Model)
            {
                var statusBadge = item.RecordStatus switch
                {
                    "Pending" => "bg-warning bg-opacity-10 text-warning border-warning border-opacity-25",
                    "Approved" => "bg-success bg-opacity-10 text-success border-success border-opacity-25",
                    "Rejected" => "bg-danger bg-opacity-10 text-danger border-danger border-opacity-25",
                    _ => "bg-secondary bg-opacity-10 text-secondary border-secondary border-opacity-25"
                };

                <div class="col-xl-4 col-md-6">
                    <div class="glass-card h-100 hover-lift transition-all overflow-hidden border-0">
                        <div
                            class="card-header border-0 bg-transparent pt-4 px-4 d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-secondary small fw-700 px-3 py-2 rounded-pill border">LOG
                                #@item.RecordID</span>
                            <span
                                class="badge @statusBadge px-3 py-2 rounded-pill fw-800 small text-uppercase">@item.RecordStatus</span>
                        </div>
                        <div class="card-body px-4 pb-4">
                            <div class="mb-4">
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-2">Authenticated Entity</h6>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="round-icon-sm bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div class="fw-700 text-dark">Citizen #@item.CitizenID</div>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <div class="d-flex justify-content-between py-2 border-bottom border-dashed small">
                                    <span class="text-muted fw-600"><i class="bi bi-calendar3 me-2"></i>Audit Date</span>
                                    <span class="text-dark fw-700">@item.RecordDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom border-dashed small">
                                    <span class="text-muted fw-600"><i class="bi bi-geo-alt me-2"></i>Address Ref</span>
                                    <span class="text-dark fw-700">#@item.AddressID</span>
                                </div>
                                <div class="d-flex justify-content-between py-2 small">
                                    <span class="text-muted fw-600"><i class="bi bi-file-earmark-check me-2"></i>Doc Ref</span>
                                    <span class="text-dark fw-700">#@item.DocumentID</span>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.RecordID"
                                    class="btn btn-white border flex-grow-1 fw-600 btn-sm py-2">
                                    <i class="bi bi-eye me-1"></i> View Log
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.RecordID"
                                        class="btn btn-white border px-3 btn-sm py-2 text-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.RecordID"
                                        class="btn btn-white border px-3 btn-sm py-2 text-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .fw-600 {
        font-weight: 600;
    }

    .ls-1 {
        letter-spacing: 0.5px;
    }

    .smaller {
        font-size: 0.7rem;
    }

    .round-icon-sm {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .border-dashed {
        border-style: dashed !important;
        border-width: 1px !important;
    }

    .btn-white {
        background: white;
        color: var(--secondary);
    }

    .btn-white:hover {
        background: #f8fafc;
        color: var(--primary);
    }
</style>
