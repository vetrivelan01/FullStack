@model IEnumerable<AddressRecord>
@{
    ViewData["Title"] = "Location Intelligence";
}

<div class="fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 fw-800 mb-1"><i class="bi bi-geo-alt text-gradient me-2"></i> Location <span
                    class="text-gradient">Intelligence</span></h1>
            <p class="text-muted small mb-0">Geospatial directory of registered residential and business entities.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> <span>Add New Location</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="glass-card mb-5">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-lg-9">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 ps-0"><i
                                class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                            class="form-control border-0 shadow-none bg-transparent"
                            placeholder="Filter by City, Street, Postal Code, or Citizen ID..." />
                    </div>
                </div>
                <div class="col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 px-4">Search</button>
                    <a asp-action="Index" class="btn btn-light px-3" title="Reset Filters"><i
                            class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 glass-card animate-on-scroll">
            <i class="bi bi-geo display-4 text-muted opacity-25 mb-3"></i>
            <h5 class="text-muted">No locations mapped</h5>
            <p class="small text-muted mb-0">Try broad search terms or register a new address.</p>
        </div>
    }
    else
    {
        <div class="row g-4 animate-on-scroll">
            @foreach (var item in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="glass-card h-100 hover-lift transition-all overflow-hidden border-0">
                        <div
                            class="card-header border-0 bg-transparent pt-4 px-4 d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-secondary small fw-700 px-3 py-2 rounded-pill border">ID
                                #@item.AddressID</span>
                            <span
                                class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-800 small">ACTIVE</span>
                        </div>
                        <div class="card-body px-4 pb-4">
                            <div class="mb-4">
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-2">Subject Mapping</h6>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="round-icon-sm bg-indigo bg-opacity-10 text-indigo">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div class="fw-700 text-dark">Citizen #@item.CitizenID</div>
                                </div>
                            </div>

                            <div class="p-3 bg-light bg-opacity-50 rounded-4 mb-4">
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-2"><i
                                        class="bi bi-geo-fill me-1"></i> Full Address</h6>
                                <div class="fw-700 text-dark mb-1">@item.HouseNumber, @item.StreetName</div>
                                <div class="text-muted small">@item.City, @item.State @item.PostalCode</div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.AddressID"
                                    class="btn btn-white border flex-grow-1 fw-600 btn-sm py-2">
                                    <i class="bi bi-eye me-1"></i> View Detail
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.AddressID"
                                        class="btn btn-white border px-3 btn-sm py-2 text-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.AddressID"
                                        class="btn btn-white border px-3 btn-sm py-2 text-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .fw-600 {
        font-weight: 600;
    }

    .ls-1 {
        letter-spacing: 0.5px;
    }

    .smaller {
        font-size: 0.7rem;
    }

    .round-icon-sm {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .text-indigo {
        color: #6366f1;
    }

    .bg-indigo {
        background-color: #6366f1;
    }

    .btn-white {
        background: white;
        color: var(--secondary);
    }

    .btn-white:hover {
        background: #f8fafc;
        color: var(--primary);
    }
</style>
