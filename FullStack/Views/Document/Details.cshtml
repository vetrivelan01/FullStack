@model IdentityDocument
@{
    ViewData["Title"] = "Document Insight";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Documents</a></li>
                    <li class="breadcrumb-item active" aria-current="page">#@Model.DocumentID</li>
                </ol>
            </nav>
            <h1 class="h3 fw-800 mb-0"><i class="bi bi-shield-check text-gradient me-2"></i> Credential <span
                    class="text-gradient">Insight</span></h1>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.DocumentID" class="btn btn-white border px-3 shadow-sm fw-600"><i
                        class="bi bi-pencil me-2"></i>Edit</a>
            }
            <a asp-action="Index" class="btn btn-light shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar: Document Status -->
        <div class="col-lg-4">
            <div class="glass-card h-100 animate-on-scroll">
                <div class="card-body p-4 text-center">
                    <div class="round-icon-lg bg-primary bg-opacity-10 text-primary mx-auto mb-4">
                        <i class="bi bi-file-earmark-lock-fill"></i>
                    </div>
                    <h4 class="fw-800 mb-1">@Model.DocumentType</h4>
                    <p class="text-muted small mb-4">Official Identification Credential</p>

                    @{
                        var today = DateTime.Today;
                        var isExpired = Model.ExpiryDate < today;
                        var isExpiringSoon = !isExpired && Model.ExpiryDate <= today.AddDays(30);
                        var statusClass = isExpired ? "bg-danger" : (isExpiringSoon ? "bg-warning" : "bg-success");
                        var statusText = isExpired ? "EXPIRED" : (isExpiringSoon ? "EXPIRING SOON" : "VALID");
                    }

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span
                            class="badge @statusClass bg-opacity-10 text-@statusClass.Replace("bg-", "") px-3 py-2 rounded-pill fw-700">@statusText</span>
                        <span
                            class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-700">IDENTITY</span>
                    </div>

                    <div class="text-start mt-4 pt-4 border-top">
                        <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-3">Security Attributes</h6>
                        <div class="p-3 bg-light bg-opacity-50 rounded-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Doc Number</span>
                                <span class="fw-800 small tracking-widest">@Model.DocumentNumber</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Issued</span>
                                <span class="fw-700 small">@Model.IssueDate.ToShortDateString()</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Expires</span>
                                <span class="fw-700 small text-danger">@Model.ExpiryDate.ToShortDateString()</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content: Holder & Validation -->
        <div class="col-lg-8">
            <div class="glass-card mb-4 animate-on-scroll" style="transition-delay: 0.1s;">
                <div class="card-header border-0 bg-transparent p-4 pb-0">
                    <h5 class="fw-800 mb-0"><i class="bi bi-person-badge text-primary me-2"></i> Verified Holder</h5>
                </div>
                <div class="card-body p-4">
                    <div
                        class="p-4 bg-light bg-opacity-50 rounded-4 d-flex align-items-center justify-content-between border border-white">
                        <div class="d-flex align-items-center gap-3">
                            <div class="round-icon bg-white text-primary border shadow-sm fw-800"
                                style="width: 56px; height: 56px; border-radius: 12px;">
                                @(Model.Citizen?.CitizenName?.Substring(0, 1) ?? "C")
                            </div>
                            <div>
                                <h6 class="mb-0 fw-800 fs-5">@(Model.Citizen?.CitizenName ?? "Unknown Citizen")</h6>
                                <p class="text-muted small mb-0">Hash ID: #@Model.CitizenID</p>
                            </div>
                        </div>
                        <a asp-controller="Citizen" asp-action="Details" asp-route-id="@Model.CitizenID"
                            class="btn btn-outline-primary fw-700 py-2 px-4 rounded-3">
                            Profile <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="glass-card animate-on-scroll" style="transition-delay: 0.2s;">
                <div class="card-header border-0 bg-transparent p-4 pb-0">
                    <h5 class="fw-800 mb-0"><i class="bi bi-patch-check text-primary me-2"></i> Compliance Analysis</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 text-center">
                        <div class="col-6 col-md-4">
                            <div class="p-3 border border-dashed rounded-4">
                                <i class="bi bi-clock-history text-muted mb-2 fs-4"></i>
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-1">Time Elapsed</h6>
                                <p class="fw-700 mb-0">@((today - Model.IssueDate).Days) Days</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 border border-dashed rounded-4">
                                <i class="bi bi-hourglass-split text-muted mb-2 fs-4"></i>
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-1">Time Left</h6>
                                <p class="fw-700 mb-0 @(isExpired ? "text-danger" : "text-success")">
                                    @(isExpired ? "EXPIRED" : (Model.ExpiryDate - today).Days + " Days")
                                </p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div
                                class="p-3 border border-dashed rounded-4 h-100 d-flex flex-column justify-content-center">
                                <h6 class="text-muted smaller fw-800 text-uppercase ls-1 mb-1">Policy Status</h6>
                                <span class="badge @(isExpired ? "bg-danger" : "bg-success") py-2">IN COMPLIANCE</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .ls-1 {
        letter-spacing: 0.5px;
    }

    .smaller {
        font-size: 0.7rem;
    }

    .round-icon-lg {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.5rem;
    }

    .round-icon {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tracking-widest {
        letter-spacing: 2px;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>
