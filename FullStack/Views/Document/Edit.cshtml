@model IdentityDocument
@{
    ViewData["Title"] = "Revise Document";
}

<div class="fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 fw-800 mb-1"><i class="bi bi-shield-shaded text-gradient me-2"></i> Revise <span
                            class="text-gradient">Document</span></h1>
                    <p class="text-muted small mb-0">Update credential metadata for document ID: #@Model.DocumentID</p>
                </div>
                <a asp-action="Details" asp-route-id="@Model.DocumentID" class="btn btn-light shadow-sm btn-sm"><i
                        class="bi bi-x-lg"></i></a>
            </div>

            <div class="glass-card animate-on-scroll">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" class="needs-validation">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 small"></div>
                        <input type="hidden" asp-for="DocumentID" />

                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="CitizenID"
                                    class="form-label fw-700 text-secondary smaller text-uppercase">Document
                                    Holder</label>
                                <select asp-for="CitizenID"
                                    class="form-select fw-600 shadow-none border-0 bg-light bg-opacity-50"
                                    asp-items="ViewBag.CitizensList" required>
                                </select>
                                <span asp-validation-for="CitizenID" class="text-danger smaller"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DocumentType"
                                    class="form-label fw-700 text-secondary smaller text-uppercase">Credential
                                    Type</label>
                                <input asp-for="DocumentType"
                                    class="form-control fw-600 shadow-none border-0 bg-light bg-opacity-50" required />
                                <span asp-validation-for="DocumentType" class="text-danger smaller"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DocumentNumber"
                                    class="form-label fw-700 text-secondary smaller text-uppercase">Document
                                    Identifier</label>
                                <input asp-for="DocumentNumber"
                                    class="form-control fw-600 shadow-none border-0 bg-light bg-opacity-50" required />
                                <span asp-validation-for="DocumentNumber" class="text-danger smaller"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IssueDate"
                                    class="form-label fw-700 text-secondary smaller text-uppercase">Issuance
                                    Date</label>
                                <input asp-for="IssueDate"
                                    class="form-control fw-600 shadow-none border-0 bg-light bg-opacity-50" type="date"
                                    required id="IssueDate" />
                                <span asp-validation-for="IssueDate" class="text-danger smaller"></span>
                                <p class="text-muted smaller mt-1"><i class="bi bi-info-circle me-1"></i> Expiry will be
                                    updated to 5 years from issuance.</p>
                            </div>

                            <div class="col-12 mt-5">
                                <button type="submit"
                                    class="btn btn-primary w-100 py-3 fw-800 shadow-glow rounded-3 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-check2-circle"></i> <span>Commit Revision</span>
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.DocumentID"
                                    class="btn btn-link w-100 text-muted text-decoration-none small fw-600 mt-2">Discard
                                    Changes</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .fw-600 {
        font-weight: 600;
    }

    .smaller {
        font-size: 0.75rem;
    }

    .shadow-glow {
        box-shadow: 0 8px 30px rgba(99, 102, 241, 0.3);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
