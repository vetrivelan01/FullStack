@model FullStack.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="fade-in">
    @if (!User.Identity.IsAuthenticated)
    {
            <section class="hero-section text-center py-5 mb-5 animate-float">
                <div class="container position-relative" style="z-index:1;">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <i class="bi bi-person-badge-fill display-1 text-gradient mb-4"></i>
                            <h1 class="display-3 fw-800 tracking-tighter mb-3">Citizen <span class="text-gradient">Records</span></h1>
                            <p class="lead text-secondary mb-5 px-lg-5">
                                Secure, unified, and efficient. The next generation of digital identity management and official record governance.
                            </p>
                            <div class="d-flex justify-content-center gap-3">
                                <a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3 shadow-glow">
                                    Access Portal <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                                <a asp-controller="Login" asp-action="Register" class="btn btn-outline-primary btn-lg px-4 py-3">
                                    Register Account
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="row g-4 mt-5">
                <div class="col-md-4">
                    <div class="glass-card p-4 text-center h-100">
                        <div class="icon-box rounded-circle d-inline-flex p-3 mb-3" style="background:rgba(59,130,246,0.1);color:var(--blue-400);">
                            <i class="bi bi-shield-check fs-2"></i>
                        </div>
                        <h5 class="fw-700">Secure Identity</h5>
                        <p class="small text-muted mb-0">Advanced encryption and biometrics protection for all citizen data.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 text-center h-100">
                        <div class="icon-box rounded-circle d-inline-flex p-3 mb-3" style="background:rgba(16,185,129,0.1);color:var(--success);">
                            <i class="bi bi-file-earmark-text fs-2"></i>
                        </div>
                        <h5 class="fw-700">Smart Documents</h5>
                        <p class="small text-muted mb-0">Automated reminders and verification for official documentation.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 text-center h-100">
                        <div class="icon-box rounded-circle d-inline-flex p-3 mb-3" style="background:rgba(6,182,212,0.1);color:var(--info);">
                            <i class="bi bi-lightning-charge fs-2"></i>
                        </div>
                        <h5 class="fw-700">Instant Access</h5>
                        <p class="small text-muted mb-0">Retrieve and share records instantly with authorized departments.</p>
                    </div>
                </div>
            </div>
    }
    else
    {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
                <div>
                    <h1 class="h2 fw-800 mb-1">Welcome back, <span class="text-gradient">@User.Identity.Name</span></h1>
                    <p class="text-muted small mb-0"><i class="bi bi-calendar3 me-2"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block">
                        <span class="badge px-3 py-2" style="background:rgba(16,185,129,0.1);color:var(--success);border:1px solid rgba(16,185,129,0.2);">
                            <i class="bi bi-circle-fill me-2 fs-xs"></i> System Active
                        </span>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                            <a asp-controller="Citizen" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
                                <i class="bi bi-plus-lg"></i> <span>New Citizen</span>
                            </a>
                    }
                </div>
            </div>

            <!-- Metric Cards -->
            <div class="row g-4 mb-5">
            @if (User.IsInRole("Admin"))
            {
                        <div class="col-xl-3 col-md-6 mb-4 fade-in-up delay-100">
                            <div class="metric-card primary h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="icon-box"><i class="bi bi-people"></i></div>
                                    <span class="badge px-2 py-1" style="background:rgba(59,130,246,0.1);color:var(--blue-400);">+12%</span>
                                </div>
                                <h6 class="text-secondary small fw-700 text-uppercase mb-1">Total Citizens</h6>
                                <h2 class="fw-800 mb-0">@Model.TotalCitizens</h2>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 mb-4 fade-in-up delay-200">
                            <div class="metric-card success h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="icon-box"><i class="bi bi-file-earmark-check"></i></div>
                                    <span class="badge px-2 py-1" style="background:rgba(16,185,129,0.1);color:var(--success);">Verified</span>
                                </div>
                                <h6 class="text-secondary small fw-700 text-uppercase mb-1">Documents Issued</h6>
                                <h2 class="fw-800 mb-0">@Model.TotalDocuments</h2>
                            </div>
                        </div>
            }
            else
            {
                        <div class="col-xl-6 col-md-12 mb-4 fade-in-up delay-100">
                            <div class="metric-card primary h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="icon-box"><i class="bi bi-person-badge"></i></div>
                                    <a asp-controller="Document" asp-action="Index" class="small fw-700" style="color:var(--blue-400);">Manage Docs <i class="bi bi-chevron-right"></i></a>
                                </div>
                                <h6 class="text-secondary small fw-700 text-uppercase mb-1">My Active Documents</h6>
                                <h2 class="fw-800 mb-0">@Model.Documents.Count</h2>
                            </div>
                        </div>
            }

                <div class="col-xl-3 col-md-6 mb-4 fade-in-up delay-300">
                    <a asp-controller="Document" asp-action="Index" asp-route-expiryFilter="30Days" class="text-decoration-none">
                        <div class="metric-card warning h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="icon-box"><i class="bi bi-clock-history"></i></div>
                                <span class="badge px-2 py-1" style="background:rgba(245,158,11,0.1);color:var(--warning);">Urgent</span>
                            </div>
                            <h6 class="text-secondary small fw-700 text-uppercase mb-1">Expiring (30d)</h6>
                            <h2 class="fw-800 mb-0" style="color:var(--warning);">@Model.ExpiringThisMonthCount</h2>
                        </div>
                    </a>
                </div>

                <div class="col-xl-3 col-md-6 mb-4 fade-in-up delay-300">
                    <a asp-controller="Document" asp-action="Index" asp-route-expiryFilter="Expired" class="text-decoration-none">
                        <div class="metric-card danger h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="icon-box"><i class="bi bi-exclamation-octagon"></i></div>
                                <span class="badge px-2 py-1" style="background:rgba(239,68,68,0.1);color:var(--danger);">Action Required</span>
                            </div>
                            <h6 class="text-secondary small fw-700 text-uppercase mb-1">Expired Records</h6>
                            <h2 class="fw-800 mb-0" style="color:var(--danger);">@Model.ExpiredCount</h2>
                        </div>
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="glass-card overflow-hidden h-100">
                        <div class="p-4 d-flex justify-content-between align-items-center" style="border-bottom:1px solid rgba(255,255,255,0.05);">
                            <h5 class="fw-800 mb-0"><i class="bi bi-bell-fill me-2" style="color:var(--danger);"></i> Compliance Monitor</h5>
                            <a asp-controller="Document" asp-action="Index" class="btn btn-sm btn-outline-primary fw-600 px-3 rounded-pill">View All</a>
                        </div>
                        <div class="p-0">
                        @if (Model.ExpiringDocuments.Any())
                        {
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Document</th>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                            <th>Owner</th>
                                            }
                                                    <th>Expires</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                        @foreach (var doc in Model.ExpiringDocuments)
                                        {
                                            var isExpired = doc.ExpiryDate < DateTime.Today;
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <div class="p-2 rounded me-3" style="background:rgba(59,130,246,0.08);">
                                                                        <i class="bi bi-file-earmark-text text-secondary"></i>
                                                                    </div>
                                                                    <div>
                                                                        <div class="fw-600 mb-0">@doc.DocumentType</div>
                                                                        <div class="text-muted small">#@doc.DocumentNumber</div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                                <td class="small fw-500">@doc.Citizen?.CitizenName</td>
                                                }
                                                            <td class="small">@doc.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                                            <td>
                                                    @if (isExpired)
                                                    {
                                                                        <span class="badge bg-danger">Expired</span>
                                                    }
                                                    else
                                                    {
                                                                        <span class="badge" style="background:rgba(245,158,11,0.15);color:var(--warning);">Warning</span>
                                                    }
                                                            </td>
                                                        </tr>
                                        }
                                            </tbody>
                                        </table>
                                    </div>
                        }
                        else
                        {
                                    <div class="text-center py-5">
                                        <div class="rounded-circle d-inline-flex p-3 mb-3" style="background:rgba(16,185,129,0.1);color:var(--success);">
                                            <i class="bi bi-shield-check fs-1"></i>
                                        </div>
                                        <h6 class="fw-700">No Alerts</h6>
                                        <p class="small text-muted mb-0 px-5">Everything is up to date. Your profile and documents are fully compliant.</p>
                                    </div>
                        }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="d-grid gap-4">
                    @if (!User.IsInRole("Admin") && Model.CurrentCitizen != null)
                    {
                                <div class="glass-card p-4">
                                    <h5 class="fw-800 mb-4 d-flex align-items-center">
                                        <i class="bi bi-person-vcard me-2" style="color:var(--blue-400);"></i> My Profile
                                    </h5>
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="rounded-circle p-3 me-3" style="background:rgba(59,130,246,0.1);color:var(--blue-400);">
                                            <i class="bi bi-person-fill fs-3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-700 mb-0">@Model.CurrentCitizen.CitizenName</h6>
                                            <p class="small text-muted mb-0">@Model.CurrentCitizen.CitizenID</p>
                                        </div>
                                    </div>
                                    <div class="p-3 rounded-3 mb-4 small" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-secondary">Nationality</span>
                                            <span class="fw-600">@Model.CurrentCitizen.Nationality</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-secondary">Status</span>
                                            <span class="badge py-1 px-2" style="background:rgba(16,185,129,0.15);color:var(--success);">Active</span>
                                        </div>
                                    </div>
                                    <a asp-controller="Citizen" asp-action="Details" asp-route-id="@Model.CurrentCitizen.CitizenID" class="btn btn-premium w-100">
                                        Full Details <i class="bi bi-chevron-right ms-2 small"></i>
                                    </a>
                                </div>
                    }

                        <div class="glass-card p-4">
                            <h5 class="fw-800 mb-4 d-flex align-items-center">
                                <i class="bi bi-lightning-charge-fill me-2" style="color:var(--warning);"></i> Commands
                            </h5>
                            <div class="d-grid gap-2">
                            @if (User.IsInRole("Admin"))
                            {
                                        <a asp-controller="Document" asp-action="Create" class="btn btn-outline-primary text-start px-3 py-2 d-flex align-items-center">
                                            <i class="bi bi-file-plus me-3 fs-5"></i>
                                            <div>
                                                <div class="fw-600 small">Issue Document</div>
                                                <div class="text-muted smaller">Generate new digital ID</div>
                                            </div>
                                        </a>
                            }
                                <a asp-controller="Document" asp-action="ExportCSV" class="btn btn-outline-secondary text-start px-3 py-2 d-flex align-items-center">
                                    <i class="bi bi-cloud-download me-3 fs-5"></i>
                                    <div>
                                        <div class="fw-600 small">Export Records</div>
                                        <div class="text-muted smaller">Download CSV report</div>
                                    </div>
                                </a>
                                <a asp-controller="Document" asp-action="Index" class="btn btn-outline-secondary text-start px-3 py-2 d-flex align-items-center">
                                    <i class="bi bi-search me-3 fs-5"></i>
                                    <div>
                                        <div class="fw-600 small">Search History</div>
                                        <div class="text-muted smaller">Browse all records</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>
